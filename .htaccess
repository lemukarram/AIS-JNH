# SENTRA — Apache rules (cPanel). Works from any sub-folder.
DirectoryIndex index.php index.html
Options -Indexes

# Never serve internals
<FilesMatch "^(config\.php|\.htaccess|\.gitignore|README.*\.md|DEMO_SCRIPT\.md)$">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^(data|tools|app|docs|source_videos)(/|$) - [F,L]

# index.html must go through index.php (installer redirect + CSRF)
RewriteRule ^index\.html$ index.php [L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(woff2|css|js|json|mp4|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
AddType font/woff2 .woff2
AddType video/mp4 .mp4
